{
  "name": "@cliftonc/finius",
  "version": "0.1.15",
  "description": "Local-first Claude Code usage & cost tracker — OTLP + transcript ingest with a live dashboard.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cliftonc/finius.git"
  },
  "bugs": {
    "url": "https://github.com/cliftonc/finius/issues"
  },
  "homepage": "https://github.com/cliftonc/finius#readme",
  "type": "module",
  "bin": {
    "finius": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "keywords": [
    "claude-code",
    "telemetry",
    "opentelemetry",
    "otlp",
    "usage-tracking",
    "cost-tracking"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.build.json && npm run copy:migrations && vite build",
    "copy:migrations": "node -e \"const fs=require('node:fs');for(const d of ['migrations','migrations-pg']){fs.rmSync('dist/server/db/'+d,{recursive:true,force:true});fs.cpSync('src/server/db/'+d,'dist/server/db/'+d,{recursive:true})}\"",
    "db:generate": "drizzle-kit generate",
    "db:generate:pg": "drizzle-kit generate --config drizzle.config.pg.ts",
    "build-link": "npm run build && npm install -g .",
    "start": "node dist/server/index.js",
    "cli": "tsx src/cli/index.ts",
    "lint": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.ts' --fix",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pg:up": "docker run -d --rm --name finius-pg -e POSTGRES_PASSWORD=finius -e POSTGRES_DB=finius -p 55432:5432 postgres:16-alpine >/dev/null && for i in $(seq 1 60); do docker exec finius-pg pg_isready -U postgres >/dev/null 2>&1 && break || sleep 0.5; done && echo 'Postgres ready → postgres://postgres:finius@localhost:55432/finius (run: npm run test:pg)'",
    "pg:down": "docker rm -f finius-pg >/dev/null 2>&1 || true",
    "test:pg": "FINIUS_TEST_DATABASE_URL=postgres://postgres:finius@localhost:55432/finius vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.0",
    "@heroui/react": "^2.8.5",
    "@hono/node-server": "^1.19.6",
    "@internationalized/date": "^3.12.0",
    "@opentelemetry/otlp-proto-exporter-base": "^0.51.1",
    "@tanstack/react-query": "^5.90.12",
    "ansi-to-html": "^0.7.2",
    "arctic": "^3.7.0",
    "chartgpu": "^0.3.2",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.7",
    "drizzle-orm": "^1.0.0-rc.3",
    "framer-motion": "^12.23.25",
    "hono": "^4.10.7",
    "lucide-react": "^0.468.0",
    "marked": "^18.0.4",
    "picocolors": "^1.1.1",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "unique-names-generator": "^4.7.1"
  },
  "peerDependencies": {
    "pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "@eslint/js": "^10.0.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.10.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^1.0.0-rc.3",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "pg": "^8.13.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}
